---
import '../styles/site.scss';

interface Props {
  lang?: string;
  title?: string;
  description?: string;
}

const { lang = 'pt-BR', title, description } = Astro.props;
const pageTitle = title ?? 'Wpp Discreto: desfoque e apelidos no WhatsApp Web';
const pageDescription = description ?? 'Escolha a área legível das conversas, desfoque mídias e use apelidos locais no WhatsApp Web com o Wpp Discreto para Chrome.';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang={lang} data-type="software" data-radius="round" data-buttons="pill" data-motion data-grade="evening">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="page-type" content="software" /><meta name="site-kind" content="software" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta property="og:title" content={title ?? "Wpp Discreto para WhatsApp Web"} /><meta property="og:description" content={description ?? "Desfoque de conversas e mídias, apelidos locais e temas claro e escuro."} /><meta property="og:type" content="website" /><meta property="og:image" content={Astro.site ? new URL('/product/conversation.png', Astro.site).href : '/product/conversation.png'} /><meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#111a19" /><link rel="icon" href="/brand/icon-128.png" type="image/png" />
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="preload" href="/fonts/onest.ttf" as="font" type="font/ttf" crossorigin />
  <link rel="stylesheet" href="/design-kit/system.css" /><link rel="stylesheet" href="/design-kit/layout/layout.css" /><link rel="stylesheet" href="/design-kit/motion/motion.css" /><link rel="stylesheet" href="/design-kit/moments/word-highlight/moment.css" />
  <script is:inline>try{const t=localStorage.getItem('wpp-site-theme');document.documentElement.dataset.grade=(t==='dark'||(t!=='light'&&matchMedia('(prefers-color-scheme: dark)').matches))?'evening':'day';}catch{document.documentElement.dataset.grade=matchMedia('(prefers-color-scheme: dark)').matches?'evening':'day';}document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700);</script>
</head>
<body>
  <div class="ambient-background" aria-hidden="true"><div class="ambient-light ambient-light--first"></div><div class="ambient-light ambient-light--second"></div></div>
  <slot />
  <script src="../scripts/site.ts"></script>
  <script is:inline type="module" src="/design-kit/system.js"></script>
  <script is:inline type="module" src="/design-kit/layout/layout.js"></script>
  <script is:inline type="module" src="/design-kit/motion/motion.js"></script>
  <script is:inline type="module" src="/design-kit/moments/moments.js"></script>
</body>
</html>
