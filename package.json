    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "lefthook": "^2.2.2",
    "sass": "^1.108.2",
    "typescript": "^6.0.3"
